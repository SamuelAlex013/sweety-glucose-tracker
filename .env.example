# Copy to .env in the repository root. Never commit .env.
DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety
# Integration tests create and drop a uniquely named schema in this database.
TEST_DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety_test
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=UTC
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy that terminates HTTPS.
TRUST_PROXY=0
# Seed credentials are intentionally public demo credentials; do not use real patient data.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=SweetyDemo2026!
