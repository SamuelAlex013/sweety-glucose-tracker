# Copy to .env in the repository root. Never commit .env.
DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety
# Integration tests create and drop a uniquely named schema in this database.
TEST_DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety_test
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=UTC
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy that terminates HTTPS.
TRUST_PROXY=0
# Seed credentials are intentionally public demo credentials; do not use real patient data.
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=SweetyDemo2026!
DEMO_DOCTOR_EMAIL=doctor@sweety.local
DEMO_DOCTOR_PASSWORD=SweetyDoctor2026!
# Daily reminder job, in APP_TIMEZONE (20:00 by default).
REMINDER_CRON=0 20 * * *
# Docker host ports and local browser origin.
POSTGRES_PASSWORD=sweety_local
DB_PORT=5432
REDIS_PORT=6379
APP_PORT=3001
DOCKER_APP_ORIGIN=http://localhost:3001
# COMPOSE_PROJECT_NAME=sweety
# HTTPS deployments can set COOKIE_SECURE=true; Compose uses local HTTP.
# COOKIE_SECURE=true
# Password used by the doctor:create provisioning command.
# DOCTOR_PASSWORD=
# Browser tests against an already running app.
# E2E_BASE_URL=http://localhost:3001
